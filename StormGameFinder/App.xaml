<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="StormGameFinder.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormGameFinder">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ Color Palette ═══ -->
            <Color x:Key="AccentPurple">#7C3AED</Color>
            <Color x:Key="AccentBlue">#3B82F6</Color>
            <Color x:Key="AccentCyan">#06B6D4</Color>
            <Color x:Key="AccentGreen">#10B981</Color>
            <Color x:Key="AccentPink">#EC4899</Color>
            <Color x:Key="SteamColor">#1B2838</Color>
            <Color x:Key="GOGColor">#86328A</Color>
            <Color x:Key="EpicColor">#313131</Color>

            <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>

            <!-- ═══ Gradient Brushes ═══ -->
            <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#A78BFA" Offset="0"/>
                <GradientStop Color="#60A5FA" Offset="0.5"/>
                <GradientStop Color="#34D399" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SearchButtonGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource AccentPurple}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentBlue}" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SubtleGradientBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#107C3AED" Offset="0"/>
                <GradientStop Color="#00000000" Offset="0.5"/>
                <GradientStop Color="#1006B6D4" Offset="1"/>
            </LinearGradientBrush>

