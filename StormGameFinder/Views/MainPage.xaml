<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="StormGameFinder.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background -->
        <Border Grid.RowSpan="2" Opacity="0.12" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="0.4"/>
                    <GradientStop Color="#06B6D4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0">
            <Grid x:Name="TitleBarDragArea" Background="Transparent"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Viewbox Width="18" Height="18">
                    <Path Data="{StaticResource GamepadPath}" Stretch="Uniform" Width="24" Height="24">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#06B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Viewbox>
                <TextBlock Text="STORM GAME FINDER" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" CharacterSpacing="60"
                           Foreground="{StaticResource TitleGradientBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,0,48">
            <StackPanel HorizontalAlignment="Center" MaxWidth="960" Spacing="24" Padding="40,0">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="-30"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
                    <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                        <Path Data="{StaticResource GamepadPath}" Stretch="Uniform" Width="24" Height="24">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A78BFA" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Viewbox>
                    <TextBlock Text="STORM GAME FINDER" FontSize="38" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TitleGradientBrush}"/>
                    <TextBlock Text="Мгновенный поиск версий и ссылок для любой игры"
                               FontSize="14" Opacity="0.5" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Search Card -->
                <Border CornerRadius="16" Padding="24,20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="Введите название игры..."
                                 FontSize="16" CornerRadius="12" Padding="16,14"
                                 KeyDown="SearchBox_KeyDown" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="SearchButton"
                                Style="{StaticResource GradientButton}"
                                Click="SearchButton_Click" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource SearchPath}" Stretch="Uniform"
                                          Width="24" Height="24" Fill="White"/>
                                </Viewbox>
                                <TextBlock Text="НАЙТИ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" Spacing="14">
                    <ProgressRing IsActive="True" Width="48" Height="48"
                                  Foreground="{StaticResource AccentPurpleBrush}"/>
                    <TextBlock x:Name="LoadingText" Text="Поиск..."
                               FontSize="14" Opacity="0.6" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error -->
                <Border x:Name="ErrorPanel" Visibility="Collapsed"
                        CornerRadius="16" Padding="32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE783;" FontSize="48" Opacity="0.4"/>
                        <TextBlock x:Name="ErrorText" FontSize="15" Opacity="0.6" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ═══ RESULTS ═══ -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Spacing="20">

                    <!-- Top: Cover + Game Info side by side -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DVD Box Cover (click to enlarge) -->
                        <Border Grid.Column="0" Width="280" Height="400"
                                CornerRadius="8" BorderThickness="2"
                                VerticalAlignment="Top"
                                Tapped="CoverBorder_Tapped"
                                PointerEntered="Cover_PointerEntered"
                                PointerExited="Cover_PointerExited">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid CornerRadius="6">
                                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                                <!-- Fallback when no image -->
                                <StackPanel x:Name="CoverFallback" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="64" Opacity="0.2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Game Info -->
                        <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top">
                            <TextBlock x:Name="GameTitle" FontSize="26" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TitleGradientBrush}"/>
                            <TextBlock x:Name="GameDescription" FontSize="13"
                                       Opacity="0.6" TextWrapping="Wrap"
                                       MaxLines="5" TextTrimming="CharacterEllipsis"/>

                            <!-- Quick version/date summary -->
                            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="12" Padding="16,12" Grid.Column="0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource AccentPurple}" Opacity="0.12"/>
                                    </Border.Background>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="ВЕРСИЯ" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentPurpleBrush}"
                                                   CharacterSpacing="60"/>
                                        <TextBlock x:Name="QuickVersion" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="12" Padding="16,12" Grid.Column="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.12"/>
                                    </Border.Background>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="ОБНОВЛЕНО" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   CharacterSpacing="60"/>
                                        <TextBlock x:Name="QuickUpdated" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Platforms Table Card -->
                    <Border CornerRadius="16" Padding="24,20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7FC;" FontSize="16"
                                          Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="ПЛАТФОРМЫ" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           CharacterSpacing="80" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Table header -->
                            <Grid Padding="12,8" Opacity="0.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Платформа" FontSize="11" FontWeight="SemiBold" Grid.Column="0"/>
                                <TextBlock Text="ID" FontSize="11" FontWeight="SemiBold" Grid.Column="1"/>
                                <TextBlock Text="Версия" FontSize="11" FontWeight="SemiBold" Grid.Column="2"/>
                                <TextBlock Text="Обновлено" FontSize="11" FontWeight="SemiBold" Grid.Column="3"/>
                            </Grid>
                            <!-- Dynamic rows -->
                            <StackPanel x:Name="PlatformTableRows" Spacing="4"/>
                            <TextBlock x:Name="NoPlatformsText" Visibility="Collapsed"
                                       Text="Платформы не найдены" FontSize="13" Opacity="0.4"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Download Links Card -->
                    <Border CornerRadius="16" Padding="24,20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource DownloadPath}" Stretch="Uniform"
                                          Width="24" Height="24" Fill="{StaticResource AccentGreenBrush}"/>
                                </Viewbox>
                                <TextBlock Text="ССЫЛКИ ДЛЯ СКАЧИВАНИЯ" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           CharacterSpacing="80" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="DownloadLinksPanel" Spacing="6"/>
                            <TextBlock x:Name="NoLinksText" Visibility="Collapsed"
                                       Text="Ссылки не найдены" FontSize="13" Opacity="0.4"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Text="Powered by Steam · GOG · DuckDuckGo · Bing · Yandex"
                           FontSize="11" Opacity="0.25" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
